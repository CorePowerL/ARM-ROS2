<?xml version="1.0"?>
<!--
  K3B 六轴机械臂 URDF (xacro 参数化版)
  依据：淘宝在售 6 自由度舵机机械臂 DIY 套件实物图
  结构：base_yaw(J1) -> shoulder_pitch(J2) -> elbow_pitch(J3)
        -> wrist_pitch(J4) -> wrist_roll(J5) -> 两指夹爪(J6)
  执行器：DS3218MG 标准 PWM 舵机（500-2500us，中点1500us，默认180°）
  说明：杆长为按图片标注的估算值，实机前必须按实物实测校准：
        1) 实测各关节轴到轴的直线距离（杆长）
        2) 实测每个舵机的关节角限位（机械限位，避免卡死）
        3) 确认各关节旋转轴朝向（本模型按常见正装结构取 Y/Z 轴）
  用法：xacro k3b_arm.urdf.xacro > k3b_arm.urdf
-->
<robot name="k3b_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ 参数（按图估算，需实测校准） ============ -->
  <xacro:property name="pi" value="3.141592653589793"/>
  <xacro:property name="base_height"    value="0.14"/>   <!-- 底座高度(估算) -->
  <xacro:property name="base_radius"    value="0.05"/>   <!-- 底座半径(估算) -->
  <xacro:property name="upper_arm_len"  value="0.43"/>   <!-- 大臂长度，图中 43cm -->
  <xacro:property name="forearm_len"    value="0.313"/>  <!-- 前臂长度，图中 31.3cm -->
  <xacro:property name="wrist_len"      value="0.09"/>   <!-- 腕部长度，图中 9cm -->
  <xacro:property name="gripper_len"    value="0.10"/>   <!-- 夹爪长度(估算) -->
  <xacro:property name="joint_speed"    value="1.5"/>    <!-- 舵机额定速度 rad/s(估算) -->

  <!-- 默认关节限位：按 DS3218MG 舵机默认 180° 量程设为 ±90°；
       实际机械限位(支架阻挡)以实测为准，若舵机为 270° 版可放宽 -->
  <xacro:property name="lim_base"   value="1.5708"/>  <!-- ±90° -->
  <xacro:property name="lim_should" value="1.5708"/>  <!-- ±90° -->
  <xacro:property name="lim_elbow"  value="1.5708"/>  <!-- ±90° -->
  <xacro:property name="lim_wpitch" value="1.5708"/>  <!-- ±90° -->
  <xacro:property name="lim_wroll"  value="1.5708"/>  <!-- ±90° -->
  <xacro:property name="lim_finger" value="0.6"/>

  <!-- ============ 颜色 ============ -->
  <material name="base_mat"> <color rgba="0.15 0.18 0.24 1.0"/> </material>
  <material name="link_mat"> <color rgba="0.35 0.42 0.52 1.0"/> </material>
  <material name="joint_mat"><color rgba="0.80 0.52 0.20 1.0"/> </material>
  <material name="grip_mat"> <color rgba="0.20 0.65 0.55 1.0"/> </material>

  <!-- ============ 底座 ============ -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <material name="base_mat"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ============ J1 底座偏航 ============ -->
  <link name="base_yaw_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <material name="joint_mat"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="base_yaw_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${lim_base}" upper="${lim_base}" effort="15.0" velocity="${joint_speed}"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- ============ J2 肩俯仰 ============ -->
  <link name="upper_arm_link">
    <visual>
      <geometry><box size="0.05 0.05 ${upper_arm_len}"/></geometry>
      <origin xyz="0 0 ${upper_arm_len/2}" rpy="0 0 0"/>
      <material name="link_mat"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 ${upper_arm_len}"/></geometry>
      <origin xyz="0 0 ${upper_arm_len/2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="base_yaw_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${lim_should}" upper="${lim_should}" effort="15.0" velocity="${joint_speed}"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- ============ J3 肘俯仰 ============ -->
  <link name="forearm_link">
    <visual>
      <geometry><box size="0.045 0.045 ${forearm_len}"/></geometry>
      <origin xyz="0 0 ${forearm_len/2}" rpy="0 0 0"/>
      <material name="link_mat"/>
    </visual>
    <collision>
      <geometry><box size="0.045 0.045 ${forearm_len}"/></geometry>
      <origin xyz="0 0 ${forearm_len/2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="elbow_pitch" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 ${upper_arm_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${lim_elbow}" upper="${lim_elbow}" effort="12.0" velocity="${joint_speed}"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- ============ J4 腕俯仰 ============ -->
  <link name="wrist_link">
    <visual>
      <geometry><box size="0.04 0.04 ${wrist_len}"/></geometry>
      <origin xyz="0 0 ${wrist_len/2}" rpy="0 0 0"/>
      <material name="joint_mat"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 ${wrist_len}"/></geometry>
      <origin xyz="0 0 ${wrist_len/2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>
  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 ${forearm_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${lim_wpitch}" upper="${lim_wpitch}" effort="8.0" velocity="${joint_speed}"/>
    <dynamics damping="0.15" friction="0.1"/>
  </joint>

  <!-- ============ J5 腕滚转 ============ -->
  <link name="wrist_roll_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <material name="joint_mat"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0003" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="0.0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_link"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0 0 ${wrist_len}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${lim_wroll}" upper="${lim_wroll}" effort="8.0" velocity="${joint_speed}"/>
    <dynamics damping="0.15" friction="0.1"/>
  </joint>

  <!-- ============ 夹爪底座(固定) ============ -->
  <link name="gripper_base_link">
    <visual>
      <geometry><box size="0.05 0.04 0.04"/></geometry>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <material name="grip_mat"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.04 0.04"/></geometry>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="gripper_base_joint" type="fixed">
    <parent link="wrist_roll_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- 末端工具坐标系(抓取参考点) -->
  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ============ J6 左指 ============ -->
  <link name="finger_left_link">
    <visual>
      <geometry><box size="0.02 0.015 0.09"/></geometry>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <material name="grip_mat"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.015 0.09"/></geometry>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="finger_left_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="finger_left_link"/>
    <origin xyz="0 0.02 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="${lim_finger}" effort="3.0" velocity="2.0"/>
  </joint>

  <!-- ============ J6 右指 ============ -->
  <link name="finger_right_link">
    <visual>
      <geometry><box size="0.02 0.015 0.09"/></geometry>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <material name="grip_mat"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.015 0.09"/></geometry>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="finger_right_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="finger_right_link"/>
    <origin xyz="0 -0.02 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="${lim_finger}" effort="3.0" velocity="2.0"/>
  </joint>

  <!-- 世界->底座，方便 RViz 固定 -->
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
